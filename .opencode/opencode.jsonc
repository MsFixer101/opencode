{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/glm-5.2:cloud",
  "provider": {
    "opencode": {
      "options": {},
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": { "baseURL": "http://localhost:11434/v1" },
      "models": {
        "qwen3.5:9b": { "name": "Qwen 3.5 9B (local)", "tool_call": true },
        "qwen3.5:35b": { "name": "Qwen 3.5 35B (local)", "tool_call": true },
        "huihui_ai/qwen3.5-abliterated:27b": { "name": "Qwen 3.5 Abliterated 27B (local)", "tool_call": true },
        "gemma4:12b": { "name": "Gemma 4 12B (local)", "tool_call": true },
        "qwen3.5:cloud": { "name": "Qwen 3.5 (cloud)", "tool_call": true },
        "glm-5.1:cloud": { "name": "GLM 5.1 (cloud)", "tool_call": true },
        "glm-5.2:cloud": { "name": "GLM 5.2 (cloud, 976K ctx)", "tool_call": true },
        "gemma4:31b-cloud": { "name": "Gemma 4 31B (cloud)", "tool_call": true },
        "nemotron-3-nano:30b-cloud": { "name": "Nemotron 3 Nano 30B (cloud)", "tool_call": true },
        "deepseek-v4-pro:cloud": { "name": "DeepSeek V4 Pro (cloud, 1M ctx)", "tool_call": true },
        "nemotron-3-ultra:cloud": { "name": "Nemotron 3 Ultra (cloud, 256K ctx)", "tool_call": true },
        "qwen3-coder-next:cloud": { "name": "Qwen3-Coder Next (cloud, 262K ctx)", "tool_call": true },
      },
    },
  },
  "permission": {
    "edit": {
      "*": "ask",
      "packages/opencode/migration/*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.db": "deny",
      "*.db-shm": "deny",
      "*.db-wal": "deny",
      ".git/*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
    },
    "bash": {
      "*": "ask",
      "rm *": "deny",
      "rmdir *": "deny",
      "git reset *": "deny",
      "git clean *": "deny",
      "git stash drop *": "deny",
      "git stash clear *": "deny",
      "git checkout -- *": "deny",
      "git restore -- *": "deny",
      "git * --force *": "deny",
      "git * --force-with-lease *": "deny",
      "git * -f *": "deny",
      "git * --no-verify *": "deny",
      "git * --hard *": "deny",
    },
  },
  "mcp": {
    "memoria": {
      "type": "local",
      "command": ["node", "/Users/christina/memoria/mcp.js"],
      "enabled": true,
    },
    "blender": {
      "type": "local",
      "command": ["/opt/homebrew/bin/uvx", "blender-mcp"],
      "environment": { "DISABLE_TELEMETRY": "true" },
      "enabled": true,
    },
  },
  "instructions": ["/Users/christina/CLAUDE.md"],
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
